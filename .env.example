APP_NAME="CoC Keeper Agent Lite"
APP_ENV=development

# PostgreSQL 数据库连接地址（用户名:密码@主机:端口/数据库名）
DATABASE_URL=postgresql+psycopg://postgres:你的密码@localhost:5432/coc_lite

# 跨域来源，前端开发服务器地址
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 第三方 OpenAI 兼容对话模型
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=替换为你的对话模型 API 密钥
LLM_MODEL=替换为你的对话模型名称
LLM_TEMPERATURE=0.7

# 千问文本嵌入模型：text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=替换为你的千问 API 密钥
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# 绘图 API（OpenAI 兼容图像生成接口）
DRAWING_API_URL=https://api.aabao.top/v1/images/generations
DRAWING_API_KEY=替换为你的绘图 API 密钥
DRAWING_MODEL=doubao-seedream-4-5-251128

# 可选：用于提示词优化的独立 LLM（留空则复用上方主 LLM）
DRAWING_LLM_BASE_URL=
DRAWING_LLM_API_KEY=
DRAWING_LLM_MODEL=

# 本地数据路径
CHROMA_PATH=./data/chroma
SCENARIO_PATH=./无光的灯塔/无光的灯塔/full.md
RULEBOOK_PATHS=./keeper-rulebook/主持人规则书.md,./investigator-handbook/full.md
CHARACTER_DIR=./无光的灯塔/预设人物卡
ASSETS_DIR=./无光的灯塔
